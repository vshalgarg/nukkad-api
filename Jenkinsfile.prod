pipeline {
	agent any

    environment {
        APP_NAME      = 'nukkad-api-prod'
        IMAGE_NAME    = 'nukkad-api-prod'
        REMOTE_PATH   = "${E2E_REMOTE_PATH_BASE}/${APP_NAME}"
        SSH_USER      = "${E2E_SSH_USER}"
        SSH_HOST      = "${E2E_SSH_HOST}"
        DB_PASSWORD   = credentials('E2E_DB_PSWD_HRMS')  // Jenkins secret
    }

    stages {
     	stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([
		  string(credentialsId: 'NUKKAD_MYSQL_PASSWORD', variable: 'MYSQL_PASSWORD'),
		  file(credentialsId: 'FIREBASE_CREDENTIAL_PATH', variable: 'FIREBASE_CRED_FILE')
		]) {
		   sh '''
                set -e  # Stop on any error

                # Create absolute path for firebase.json
                WORK_DIR="$(pwd)"
                TARGET_JSON="$WORK_DIR/firebase.json"

                echo "Copying Firebase credentials to: $TARGET_JSON"
                cp "$FIREBASE_CRED_FILE" "$TARGET_JSON"
                ls -l "$TARGET_JSON"

                echo "Building Docker image: ${IMAGE_NAME}:latest"
                docker build -t ${IMAGE_NAME}:latest .

                echo "Cleaning up Firebase credentials..."
                rm -f "$TARGET_JSON"

                echo "✅ Docker build complete!"
               '''
		}
            }
        }

        stage('Save Docker Image') {
            steps {
                sh "docker save ${IMAGE_NAME}:latest -o ${IMAGE_NAME}.tar"
            }
        }

        stage('Transfer Docker Image') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'e2e-ssh', keyFileVariable: 'SSH_KEY')]) {
                    sh """
                        ssh -i $SSH_KEY -o StrictHostKeyChecking=no $SSH_USER@$SSH_HOST "mkdir -p $REMOTE_PATH"
                        rsync -avz --progress -e "ssh -i $SSH_KEY" ${IMAGE_NAME}.tar $SSH_USER@$SSH_HOST:${REMOTE_PATH}/
                    """
                }
            }
        }

	stage('Deploy on E2E') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'e2e-ssh', keyFileVariable: 'SSH_KEY'),
        			 file(credentialsId: 'FIREBASE_CREDENTIAL_PATH', variable: 'FIREBASE_CRED_FILE')]) {
                    sh """
                    	cp "$FIREBASE_CRED_FILE" firebase.json
                        ssh -i \$SSH_KEY -o StrictHostKeyChecking=no $SSH_USER@$SSH_HOST << 'EOF'
                        cd $REMOTE_PATH
                        docker load -i ${IMAGE_NAME}.tar

                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true

                        docker run -d --name ${IMAGE_NAME} \\
                            --network backend-net \\
                            -e SPRING_PROFILES_ACTIVE=prod \\
                            -e spring.datasource.password=${DB_PASSWORD} \\
                            -e FIREBASE_CREDENTIAL_PATH=/app/firebase.json \\
                            --restart unless-stopped \\
                            ${IMAGE_NAME}:latest
			rm -f firebase.json
                        exit 0
		EOF
                    """
                }
            }
        }

	stage('Clean Up') {
	    steps {
		sh 'docker image prune -f'
	    }
	}
    }
    post {
        success {
            echo "✅ Dockerized deployment successful!"
        }
        failure {
            echo "❌ Dockerized deployment failed."
        }
    }
}
